# Opentrons Liquid Handler Agent - Environment Configuration
# Copy this file to .env and set your secure values

# HMAC-SHA256 Audit Trail Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=

# Model provider (only deterministic mock is implemented)
MODEL_PROVIDER=mock

# Optional access key for GET /api/audit/logs (omit or leave blank to disable)
AUDIT_LOG_ACCESS_KEY=
